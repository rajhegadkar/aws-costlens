# Server configuration (0.0.0.0 allows access from LAN devices)
PORT=4000
HOST=0.0.0.0

# AWS Configuration (Read-Only Mode)
# Leave blank to use AWS CLI default profile or IAM role, or specify explicitly
AWS_REGION=us-east-1
AWS_PROFILE=default

# Optional IAM User / Access Keys (if not using ~/.aws/credentials or SSO)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Cache TTL in milliseconds (default: 1 hour = 3600000 ms to minimize Cost Explorer API fees)
CACHE_TTL_MS=3600000

# Force Demo Mode if you want to explore the dashboard without AWS credentials
DEMO_MODE=false

# Dashboard Login Credentials (Default: admin / admin123)
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=admin123

